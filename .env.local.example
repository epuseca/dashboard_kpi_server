# Copy file này thành .env.local (KHÔNG commit .env.local lên Git) rồi điền giá trị thật.

# Chuỗi kết nối MongoDB Atlas của bạn
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DB=dashboard-tt4

# Mật khẩu đăng nhập trang quản trị (/admin) — tự đặt 1 mật khẩu mạnh
ADMIN_PASSWORD=doi-mat-khau-nay

# Chuỗi bí mật dùng để ký cookie phiên đăng nhập admin — tự đặt 1 chuỗi ngẫu nhiên dài
ADMIN_SESSION_SECRET=doi-chuoi-bi-mat-nay-cang-dai-cang-ngau-nhien-cang-tot
